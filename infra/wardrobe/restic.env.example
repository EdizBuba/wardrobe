# Separate dedicated offsite repository. Actual /etc/wardrobe/restic.env: root, 0600.
# This is a shell environment file: quote values using safe single quotes.
# Obtain an existing provider configuration; no subscription is created automatically.
RESTIC_REPOSITORY=''
RESTIC_PASSWORD_FILE='/etc/wardrobe/restic-password'
# Provider-specific credentials belong here, never in Git.
